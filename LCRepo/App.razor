<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" DefaultLayout="@typeof(LCRepo.Layout.MainLayout)" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView Layout="@typeof(LCRepo.Layout.MainLayout)">
            <h1>Page not found</h1>
            <p>This page has moved. <a href="">Return home</a>.</p>
        </LayoutView>
    </NotFound>
</Router>
