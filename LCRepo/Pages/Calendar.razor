@page "/calendar"
@inject CommunityService Community

<PageTitle>Event Calendar | Living Culture</PageTitle>
<section class="page-heading"><div class="container"><p class="eyebrow">Show up and grow</p><h1>Community calendar.</h1><p class="lead">Bible study every Thursday, plus special gatherings added by Living Culture leaders.</p></div></section>
<section class="section"><div class="container">
    <div class="calendar-toolbar"><button class="btn btn-outline btn-small" @onclick="Previous" aria-label="Previous month">←</button><h2>@Month.ToString("MMMM yyyy", CultureInfo.InvariantCulture)</h2><button class="btn btn-outline btn-small" @onclick="Next" aria-label="Next month">→</button></div>
    @if (!string.IsNullOrEmpty(Error)){<div class="message error" role="alert">@Error</div>}
    <div class="calendar-grid" aria-label="Monthly Living Culture calendar">
        @foreach (var label in new [] { "Sun", "Mon", "Tue", "Wed", "Thu", "Fri", "Sat" }) { <div class="weekday">@label</div> }
        @foreach (var cell in MonthCells)
        {
            <div class="calendar-cell @(cell.HasValue && IsThursday(cell.Value) ? "highlight" : "")">
                @if (cell.HasValue)
                {
                    <strong>@cell.Value</strong>
                    @if (IsThursday(cell.Value))
                    {
                        <span class="calendar-item">Bible Study · 19:00</span>
                    }
                    @foreach(var ev in EventsFor(cell.Value))
                    {
                        <span class="calendar-item event-special" title="@ev.Details">@ev.Title</span>
                    }
                }
            </div>
        }
    </div>
    <div class="legend"><span class="legend-dot"></span> Thursday Bible study · 19:00 SAST</div>
    <div class="notice-help">The recurring Thursday entry is our regular gathering. Please check with ministry leaders for venue information or schedule changes.</div>
    <h2 class="subheading">Upcoming additional events</h2>
    @if (Loading){<p class="muted">Loading events…</p>}
    else if (Upcoming.Count == 0){<p class="muted">More events will be posted here soon.</p>}
    else {
        <div class="cards-grid">
        @foreach(var ev in Upcoming)
        {
            <article class="content-card"><p class="eyebrow">@Sast(ev.StartsAt).ToString("ddd dd MMM yyyy · HH:mm") SAST</p><h3>@ev.Title</h3><p>@ev.Details</p>@if(!string.IsNullOrWhiteSpace(ev.Venue)){<p class="muted">Venue: @ev.Venue</p>}</article>
        }
        </div>
    }
</div></section>
@code {
    private DateTime Month = new(DateTime.Today.Year, DateTime.Today.Month, 1);
    private List<EventItem> Events = new();
    private bool Loading = true;
    private string Error = "";
    private IEnumerable<int?> MonthCells =>
        Enumerable.Repeat<int?>(null, (int)Month.DayOfWeek)
            .Concat(Enumerable.Range(1, DateTime.DaysInMonth(Month.Year, Month.Month)).Select(x => (int?)x));
    private List<EventItem> Upcoming => Events.Where(x => x.StartsAt >= DateTimeOffset.UtcNow.AddDays(-1)).Take(24).ToList();
    private static DateTime Sast(DateTimeOffset when) => when.ToOffset(TimeSpan.FromHours(2)).DateTime;
    private bool IsThursday(int d) => new DateTime(Month.Year, Month.Month, d).DayOfWeek == DayOfWeek.Thursday;
    private IEnumerable<EventItem> EventsFor(int d) =>
        Events.Where(x => Sast(x.StartsAt).Date == new DateTime(Month.Year, Month.Month, d).Date);
    private void Previous() => Month = Month.AddMonths(-1);
    private void Next() => Month = Month.AddMonths(1);
    protected override async Task OnInitializedAsync()
    {
        try { Events = await Community.EventsAsync(); }
        catch (Exception ex) { Error = "Could not load events: " + ex.Message; }
        finally { Loading = false; }
    }
}
