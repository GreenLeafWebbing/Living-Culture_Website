@page "/member"
@inject CommunityService Community

<PageTitle>Member Portal | Living Culture</PageTitle>
<section class="page-heading"><div class="container"><p class="eyebrow">You belong here</p><h1>Member portal.</h1><p class="lead">Sign in to your Living Culture community account or register to join.</p></div></section>
<section class="section"><div class="container">
    @if (Loading){<div class="message">Loading your session…</div>}
    else if (Member.SignedIn) {
        <div class="content-card member-panel"><p class="eyebrow">Welcome back</p><h2>@Member.Email</h2>
        <p>Signed in as <strong>@(Member.IsAdmin ? "administrator" : "community member")</strong>.</p>
        <div class="btn-row">
            @if(Member.IsAdmin){<a class="btn btn-primary" href="admin">Open admin dashboard →</a>}
            <button class="btn btn-outline" @onclick="SignOutAsync" disabled="@Busy">Sign out</button>
        </div></div>
    } else {
        <div class="forms-grid">
            <form class="form-card" @onsubmit="SignInAsync" @onsubmit:preventDefault>
                <h2>Sign in</h2>
                <label>Email address<input type="email" required autocomplete="email" @bind="LoginEmail" /></label>
                <label>Password<input type="password" required autocomplete="current-password" @bind="LoginPassword" /></label>
                <button class="btn btn-primary" type="submit" disabled="@Busy">Sign in</button>
                <p class="muted small">Use the password you created during registration.</p>
            </form>
            <form class="form-card" @onsubmit="SignUpAsync" @onsubmit:preventDefault>
                <h2>Create an account</h2>
                <label>Your name<input required maxlength="100" autocomplete="name" @bind="RegisterName" /></label>
                <label>Email address<input type="email" required autocomplete="email" @bind="RegisterEmail" /></label>
                <label>New password<input type="password" required minlength="12" autocomplete="new-password" @bind="RegisterPassword" /></label>
                <button class="btn btn-outline" type="submit" disabled="@Busy">Create account</button>
                <p class="muted small">You'll be sent an email verification link. Never reuse a password shared in a chat.</p>
            </form>
        </div>
    }
    @if(!string.IsNullOrWhiteSpace(Message)){<div class="message @(IsError ? "error" : "")" role="status">@Message</div>}
    <p class="notice-help">Email verification may require additional ministry email-provider setup before public signups can be completed.</p>
</div></section>
@code {
    private MemberState Member = new();
    private string LoginEmail = "";
    private string LoginPassword = "";
    private string RegisterName = "";
    private string RegisterEmail = "";
    private string RegisterPassword = "";
    private string Message = "";
    private bool IsError;
    private bool Busy;
    private bool Loading = true;
    protected override async Task OnInitializedAsync()
    {
        try { Member = await Community.WhoAmIAsync(); }
        catch (Exception ex) { IsError = true; Message = "Could not load login: " + ex.Message; }
        finally { Loading = false; }
    }
    private async Task SignInAsync()
    {
        Busy = true; IsError = false; Message = "";
        try { Message = await Community.SignInAsync(LoginEmail.Trim(), LoginPassword); LoginPassword = ""; Member = await Community.WhoAmIAsync(); }
        catch (Exception ex) { IsError = true; Message = ex.Message; LoginPassword = ""; }
        finally { Busy = false; }
    }
    private async Task SignUpAsync()
    {
        Busy = true; IsError = false; Message = "";
        try { Message = await Community.SignUpAsync(RegisterName.Trim(), RegisterEmail.Trim(), RegisterPassword); RegisterPassword = ""; }
        catch (Exception ex) { IsError = true; Message = ex.Message; RegisterPassword = ""; }
        finally { Busy = false; }
    }
    private async Task SignOutAsync()
    {
        Busy = true; Message = "";
        try { await Community.SignOutAsync(); Member = new MemberState(); Message = "You've been signed out."; }
        catch (Exception ex) { IsError = true; Message = ex.Message; }
        finally { Busy = false; }
    }
}
