@page "/request"
@inject CommunityService Community

<PageTitle>Prayer and Faith Questions | Living Culture</PageTitle>
<section class="page-heading"><div class="container"><p class="eyebrow">You're not alone</p><h1>Prayer &amp; life questions.</h1><p class="lead">Have something on your heart? Ask a meaningful question or send us a prayer request. We will treat your message confidentially.</p></div></section>
<section class="section"><div class="container forms-grid">
    <form class="form-card" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
        <h2>Send your request</h2>
        <label>I'm reaching out about
            <select @bind="Draft.Kind"><option value="prayer">Prayer request</option><option value="question">Question about faith or life</option></select>
        </label>
        <label>Your name<input required maxlength="100" autocomplete="name" @bind="Draft.FullName" /></label>
        <label>Your email<input type="email" required maxlength="254" autocomplete="email" @bind="Draft.Email" /></label>
        <label>Message<textarea required minlength="10" maxlength="5000" rows="6" @bind="Draft.Message"></textarea></label>
        <label class="check-field"><input type="checkbox" @bind="Draft.KeepPrivate" /> Please keep this request private to approved ministry leadership.</label>
        <label class="check-field"><input type="checkbox" required @bind="Draft.Consent" /> I consent to Living Culture storing my request and contacting me about it.</label>
        <button class="btn btn-primary" type="submit" disabled="@Busy">@(Busy ? "Sending…" : "Send confidential request →")</button>
        @if(!string.IsNullOrWhiteSpace(Message)){<p class="message @(IsError ? "error" : "")" role="status">@Message</p>}
    </form>
    <aside class="content-card side-content"><p class="eyebrow">A space to be heard</p><h2>Every question matters.</h2><p>We want to walk alongside you and care for the people in our community.</p>
        <div class="notice-help">Only approved administrators can read submissions. Private messages are never posted to the public notice board.</div>
        <div class="notice-help">This form is not an emergency service. If someone is in immediate danger, contact local emergency services.</div>
    </aside>
</div></section>
@code {
    private InquiryDraft Draft = new();
    private string Message = "";
    private bool IsError;
    private bool Busy;
    private async Task SubmitAsync()
    {
        if (!Draft.Consent) { IsError = true; Message = "Please agree to the consent statement."; return; }
        Busy = true; IsError = false; Message = "";
        try { Message = await Community.SendInquiryAsync(Draft); Draft = new(); }
        catch (Exception ex) { IsError = true; Message = ex.Message; }
        finally { Busy = false; }
    }
}
